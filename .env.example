PORT=3000
NODE_ENV=development
API_KEY=your-secret-api-key-change-this
JWT_SECRET=your-jwt-secret-change-this
ADMIN_USERNAME="abenezerad"
ADMIN_PASSWORD_HASH="$2b$10$your-hashed-password-here"
ADMIN_EMAIL="admin@yourdomain.com"
DATABASE_PATH=./database/admin.db

# Email Configuration for OTP
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Alternative: SMTP Configuration
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Development: Use Ethereal for testing
# EMAIL_SERVICE=ethereal

# OTP Configuration
OTP_ENABLED=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# For development only - use ADMIN_PASSWORD_HASH in production
# ADMIN_PASSWORD="your-plain-text-password"
